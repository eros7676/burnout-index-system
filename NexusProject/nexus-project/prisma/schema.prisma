generator client {
  provider = "prisma-client-js"
}

enum ResultadoAuditoria {
  EXITO
  FALLO
  DENEGADO
}

enum OrigenAuditoria {
  WEB
  CLI
  SISTEMA
}

// Append-only: registrarEvento is the only writer (NIST AU-9, AU-12). New columns are
// nullable so pre-migration rows stay valid and are never rewritten.
model EventoAuditoria {
  eventoId      String             @id @default(cuid()) @db.VarChar(36)
  /// One-shot transitions: ENTIDAD:recurso:ACCION. Repeatable events: ACCION:recurso:solicitudId.
  clave         String             @unique @db.VarChar(180)
  accion        String             @db.VarChar(40)
  entidad       String             @db.VarChar(20)
  recursoId     String             @db.VarChar(64)
  /// Employee whose personal data the event concerns; null for configuration and imports.
  sujetoId      String?            @db.VarChar(64)
  actorId       String             @db.VarChar(64)
  /// Operator snapshot at event time (name and role decide what the actor could do).
  actorNombre   String?            @db.VarChar(160)
  actorRol      String?            @db.VarChar(20)
  origen        OrigenAuditoria?
  resultado     ResultadoAuditoria @default(EXITO)
  /// Closed error-code catalog, never free text.
  motivo        String?            @db.VarChar(64)
  /// One HTTP request, also returned as X-Request-Id.
  solicitudId   String?            @db.VarChar(36)
  /// One business operation across requests (importId, draft id, alertId).
  correlacionId String?            @db.VarChar(64)
  /// [{ campo, antes, despues }]: changed fields only; never index or indicator values.
  cambios       Json?
  justificacion String?            @db.VarChar(280)
  detalles      Json
  createdAt     DateTime           @default(now()) @db.DateTime(3)

  @@index([createdAt, eventoId])
  @@index([entidad, recursoId, createdAt])
  @@index([actorId, createdAt])
  @@index([accion, createdAt])
  @@index([sujetoId, createdAt])
  @@index([correlacionId, createdAt])
  @@index([resultado, createdAt])
  @@index([solicitudId])
  @@index([recursoId, createdAt])
}

datasource db {
  provider = "mysql"
  url      = env("DATABASE_URL")
}

enum TipoEmpleado {
  TECNICO
  TEAM_LEAD
  GERENCIA
}

enum EstadoImportacion {
  VALIDADA
  RECHAZADA
  CANCELADA
  CONFIRMADA
}

enum EstadoJob {
  PENDIENTE
  PROCESANDO
  COMPLETADO
  FALLIDO
}

enum OrigenJob {
  IMPORTACION
  CAMBIO_REGLAS
}

enum Nivel {
  BAJO
  MEDIO
  ALTO
  INCOMPLETO
}

enum VigenciaAlerta {
  ACTIVA
  SUPERADA
}

enum MotivoDestinatario {
  OK
  SIN_DESTINATARIO
}

enum CanalAlerta {
  INTERNO
  SIMULADO
  CORREO
}

enum EstadoEnvio {
  NO_APLICA
  PENDIENTE
  ENVIADO
  FALLIDO
  SIN_DESTINATARIO
}

enum MotivoAsignacion {
  ALTA
  CAMBIO_EQUIPO
  CAMBIO_PUESTO
  CAMBIO_LIDER
  BAJA
  CORRECCION
}

model Equipo {
  teamId       String               @id @db.VarChar(64)
  nombre       String               @db.VarChar(160)
  activo       Boolean              @default(true)
  /// TEAM_LEAD who is the responsable of the team's technicians.
  liderId      String?              @unique @db.VarChar(64)
  /// GERENCIA who is the responsable of the team's lead.
  gerenteId    String?              @db.VarChar(64)
  createdAt    DateTime             @default(now()) @db.DateTime(3)
  updatedAt    DateTime             @default(now()) @updatedAt @db.DateTime(3)
  lider        Empleado?            @relation("LiderEquipo", fields: [liderId], references: [employeeId], onDelete: Restrict, onUpdate: Restrict)
  gerente      Empleado?            @relation("GerenteEquipo", fields: [gerenteId], references: [employeeId], onDelete: Restrict, onUpdate: Restrict)
  empleados    Empleado[]
  asignaciones AsignacionEmpleado[]

  @@index([gerenteId])
}

// Gerencia es destinatario del seed; no es un empleado evaluable en el contrato P0.
model Empleado {
  employeeId       String               @id @db.VarChar(64)
  nombre           String               @db.VarChar(160)
  tipo             TipoEmpleado
  activo           Boolean              @default(true)
  enCobertura      Boolean              @default(true)
  teamId           String?              @db.VarChar(64)
  responsableId    String?              @db.VarChar(64)
  equipo           Equipo?              @relation(fields: [teamId], references: [teamId], onDelete: Restrict, onUpdate: Restrict)
  responsable      Empleado?            @relation("Responsables", fields: [responsableId], references: [employeeId], onDelete: Restrict, onUpdate: Restrict)
  subordinados     Empleado[]           @relation("Responsables")
  /// Current projection; history lives in AsignacionEmpleado.
  fechaIngreso     DateTime?            @db.Date
  fechaBaja        DateTime?            @db.Date
  createdAt        DateTime             @default(now()) @db.DateTime(3)
  updatedAt        DateTime             @default(now()) @updatedAt @db.DateTime(3)
  periodos         PeriodoEmpleado[]
  alertas          Alerta[]             @relation("EmpleadoAlertado")
  alertasRecibidas Alerta[]             @relation("DestinatarioAlerta")
  asignaciones     AsignacionEmpleado[]
  lidera           Equipo?              @relation("LiderEquipo")
  gerencia         Equipo[]             @relation("GerenteEquipo")
  casos            CasoSeguimiento[]

  @@index([teamId, activo, enCobertura])
  @@index([responsableId])
}

// Effective-dated assignment history (one row per change; the current one has hasta = null).
model AsignacionEmpleado {
  asignacionId  String           @id @default(cuid()) @db.VarChar(36)
  employeeId    String           @db.VarChar(64)
  /// Monday, inclusive.
  desde         DateTime         @db.Date
  /// Next row's desde, exclusive; null = current.
  hasta         DateTime?        @db.Date
  tipo          TipoEmpleado
  teamId        String?          @db.VarChar(64)
  responsableId String?          @db.VarChar(64)
  enCobertura   Boolean
  activo        Boolean
  motivo        MotivoAsignacion
  comentario    String?          @db.VarChar(500)
  registradoPor String           @db.VarChar(64)
  createdAt     DateTime         @default(now()) @db.DateTime(3)
  empleado      Empleado         @relation(fields: [employeeId], references: [employeeId], onDelete: Restrict, onUpdate: Restrict)
  equipo        Equipo?          @relation(fields: [teamId], references: [teamId], onDelete: Restrict, onUpdate: Restrict)

  @@unique([employeeId, desde])
  @@index([teamId, desde])
}

model Importacion {
  importId              String               @id @default(cuid()) @db.VarChar(36)
  sourceName            String               @db.VarChar(255)
  sourceHash            String               @db.Char(64)
  schemaVersion         String               @default("indicadores-v1") @db.VarChar(32)
  uploadedAt            DateTime             @default(now()) @db.DateTime(3)
  uploadedBy            String               @db.VarChar(64)
  status                EstadoImportacion
  expiresAt             DateTime             @db.DateTime(3)
  confirmedAt           DateTime?            @db.DateTime(3)
  confirmedBy           String?              @db.VarChar(64)
  cancelledAt           DateTime?            @db.DateTime(3)
  cancelledBy           String?              @db.VarChar(64)
  totalFilas            Int
  nuevas                Int
  omitidas              Int
  errores               Json
  warnings              Json
  // Respuesta conservada para devolver la misma confirmación sin reinsertar.
  resultadoConfirmacion Json?
  temporal              ImportacionTemporal?
  registros             RegistroLaboral[]
  tareas                TareaSemana[]
  jornadas              JornadaSemana[]
  job                   ProcessingJob?

  @@index([status, expiresAt])
  @@index([sourceHash])
}

// Solo contiene filas normalizadas y muestra: se elimina al cancelar/confirmar/vencer.
// Los metadatos de Importacion permanecen. No representa registros confirmados.
model ImportacionTemporal {
  importId    String      @id @db.VarChar(36)
  datos       Json
  muestra     Json
  importacion Importacion @relation(fields: [importId], references: [importId], onDelete: Cascade, onUpdate: Restrict)
}

// La clave lógica existe una sola vez. Los dos punteros son la fuente de vigencia;
// no usar un booleano único (impediría conservar varias versiones históricas).
model PeriodoEmpleado {
  periodoId           String             @id @default(cuid()) @db.VarChar(36)
  employeeId          String             @db.VarChar(64)
  periodStart         DateTime           @db.Date
  periodEnd           DateTime           @db.Date
  registroVigenteId   String?            @db.VarChar(36)
  evaluacionVigenteId String?            @db.VarChar(36)
  empleado            Empleado           @relation(fields: [employeeId], references: [employeeId], onDelete: Restrict, onUpdate: Restrict)
  registros           RegistroLaboral[]  @relation("RegistrosPeriodo")
  evaluaciones        Evaluacion[]       @relation("EvaluacionesPeriodo")
  // FKs compuestas impiden apuntar a una versión perteneciente a otra semana/persona.
  registroVigente     RegistroLaboral?   @relation("RegistroVigente", fields: [registroVigenteId, periodoId], references: [recordId, periodoId], onDelete: Restrict, onUpdate: Restrict)
  evaluacionVigente   Evaluacion?        @relation("EvaluacionVigente", fields: [evaluacionVigenteId, periodoId], references: [evaluationId, periodoId], onDelete: Restrict, onUpdate: Restrict)
  trabajos            ProcessingJobPar[]

  @@unique([employeeId, periodStart, periodEnd], map: "periodo_empleado_semana_key")
  @@unique([periodoId, employeeId])
  @@index([periodStart, employeeId])
  @@index([registroVigenteId, periodoId])
  @@index([evaluacionVigenteId, periodoId])
}

model RegistroLaboral {
  recordId                    String            @id @default(cuid()) @db.VarChar(36)
  periodoId                   String            @db.VarChar(36)
  employeeId                  String            @db.VarChar(64)
  sourceImportId              String            @db.VarChar(36)
  dataVersion                 Int               @default(1)
  fingerprint                 String            @db.Char(64)
  supersedesRecordId          String?           @db.VarChar(36)
  // Double conserva la precisión de los number del contrato; no redondear horas.
  horasExtra                  Float             @db.Double
  diasConsecutivosSinDescanso Int
  tareasActivas               Int
  tareasPendientes            Int
  tareasVencidas              Int
  vacacionesPendientesDias    Int
  horasTrabajadas             Float?            @db.Double
  diasDesdeUltimasVacaciones  Int?
  /// SHA-256 of the normalized task rows attached to this version; null = summary without detail.
  huellaTareas                String?           @db.Char(64)
  /// SHA-256 of the normalized day rows attached to this version; null = summary without day detail.
  huellaJornadas              String?           @db.Char(64)
  createdAt                   DateTime          @default(now()) @db.DateTime(3)
  periodo                     PeriodoEmpleado   @relation("RegistrosPeriodo", fields: [periodoId, employeeId], references: [periodoId, employeeId], onDelete: Restrict, onUpdate: Restrict)
  importacion                 Importacion       @relation(fields: [sourceImportId], references: [importId], onDelete: Restrict, onUpdate: Restrict)
  vigenteEn                   PeriodoEmpleado[] @relation("RegistroVigente")
  anteriorVersion             RegistroLaboral?  @relation("VersionesRegistro", fields: [supersedesRecordId, periodoId], references: [recordId, periodoId], onDelete: Restrict, onUpdate: Restrict)
  siguientesVersiones         RegistroLaboral[] @relation("VersionesRegistro")
  evaluacionesActuales        Evaluacion[]      @relation("RegistroActualEvaluado")
  evaluacionesComoAntecedente Evaluacion[]      @relation("RegistroAnteriorEvaluado")
  tareas                      TareaSemana[]
  jornadas                    JornadaSemana[]

  @@unique([periodoId, dataVersion])
  @@unique([recordId, periodoId])
  @@unique([recordId, employeeId])
  @@index([periodoId, employeeId])
  @@index([supersedesRecordId, periodoId])
  @@index([sourceImportId])
}

enum EstadoTareaCierre {
  COMPLETADA
  PENDIENTE
  VENCIDA
}

// One task as it stood at the close of one employee-week (Kimball periodic snapshot).
// Immutable: it substantiates the counts of the RegistroLaboral version it hangs from.
model TareaSemana {
  tareaSemanaId  String            @id @default(cuid()) @db.VarChar(36)
  recordId       String            @db.VarChar(36)
  periodoId      String            @db.VarChar(36)
  employeeId     String            @db.VarChar(64)
  periodStart    DateTime          @db.Date
  sourceImportId String            @db.VarChar(36)
  taskId         String            @db.VarChar(64)
  titulo         String            @db.VarChar(160)
  origen         String            @db.VarChar(40)
  origenRef      String?           @db.VarChar(255)
  asignadaEl     DateTime          @db.Date
  venceEl        DateTime?         @db.Date
  completadaEl   DateTime?         @db.Date
  estadoCierre   EstadoTareaCierre
  /// VENCIDA only: period end minus due date, in days.
  diasAtraso     Int?
  registro       RegistroLaboral   @relation(fields: [recordId, periodoId], references: [recordId, periodoId], onDelete: Restrict, onUpdate: Restrict)
  importacion    Importacion       @relation(fields: [sourceImportId], references: [importId], onDelete: Restrict, onUpdate: Restrict)

  @@unique([recordId, taskId])
  @@index([recordId, estadoCierre, diasAtraso])
  @@index([employeeId, taskId, periodStart])
  @@index([sourceImportId])
}

/// What a day of an employee-week was. VACACIONES and LICENCIA carry no reason: no health data.
enum TipoDia {
  TRABAJO
  DESCANSO
  VACACIONES
  LICENCIA
}

// One day of one employee-week. Immutable: it substantiates the hours, the rest streak and the
// last vacation day of the RegistroLaboral version it hangs from (jornadas-v1).
model JornadaSemana {
  jornadaSemanaId String          @id @default(cuid()) @db.VarChar(36)
  recordId        String          @db.VarChar(36)
  periodoId       String          @db.VarChar(36)
  employeeId      String          @db.VarChar(64)
  periodStart     DateTime        @db.Date
  sourceImportId  String          @db.VarChar(36)
  fecha           DateTime        @db.Date
  tipo            TipoDia
  // Double keeps the precision of the contract's numbers, as RegistroLaboral does.
  horasTrabajadas Float           @db.Double
  horasExtra      Float           @db.Double
  registro        RegistroLaboral @relation(fields: [recordId, periodoId], references: [recordId, periodoId], onDelete: Restrict, onUpdate: Restrict)
  importacion     Importacion     @relation(fields: [sourceImportId], references: [importId], onDelete: Restrict, onUpdate: Restrict)

  @@unique([recordId, fecha])
  @@index([employeeId, periodStart])
  @@index([sourceImportId])
}

model ConfiguracionIndice {
  version            String          @id @db.VarChar(64)
  effectiveFrom      DateTime        @unique @db.Date
  windowDays         Int             @default(7)
  persistencePeriods Int             @default(2)
  weights            Json
  thresholds         Json
  mediumLimit        Float           @db.Double
  highLimit          Float           @db.Double
  minExceededFactors Int
  createdBy          String          @db.VarChar(64)
  createdAt          DateTime        @default(now()) @db.DateTime(3)
  evaluaciones       Evaluacion[]
  jobs               ProcessingJob[]
  borrador           BorradorReglas?
}

enum EstadoBorradorReglas {
  BORRADOR
  EN_REVISION
  PUBLICADO
  DESCARTADO
}

// Reason, simulation and approval of a rules version. ConfiguracionIndice gets no new
// columns: the engine reads it field by field (workforce-admin R10).
model BorradorReglas {
  borradorId       String               @id @default(cuid()) @db.VarChar(36)
  baseVersion      String               @db.VarChar(64)
  /// weights, thresholds, mediumLimit, highLimit, minExceededFactors, effectiveFrom
  propuesta        Json
  motivo           String               @db.VarChar(500)
  estado           EstadoBorradorReglas @default(BORRADOR)
  /// SHA-256 of propuesta; editing invalidates simulation and approval.
  huella           String               @db.Char(64)
  simulacion       Json?
  simulacionHuella String?              @db.Char(64)
  retroactivo      Boolean              @default(false)
  creadoPor        String               @db.VarChar(64)
  aprobadoPor      String?              @db.VarChar(64)
  aprobadoAt       DateTime?            @db.DateTime(3)
  versionPublicada String?              @unique @db.VarChar(64)
  createdAt        DateTime             @default(now()) @db.DateTime(3)
  updatedAt        DateTime             @default(now()) @updatedAt @db.DateTime(3)
  version          ConfiguracionIndice? @relation(fields: [versionPublicada], references: [version], onDelete: Restrict, onUpdate: Restrict)

  @@index([estado, updatedAt])
}

model Evaluacion {
  evaluationId           String              @id @default(cuid()) @db.VarChar(36)
  periodoId              String              @db.VarChar(36)
  employeeId             String              @db.VarChar(64)
  actualRecordId         String              @db.VarChar(36)
  anteriorRecordId       String?             @db.VarChar(36)
  rulesVersion           String              @db.VarChar(64)
  engineVersion          String              @default("cu02-v1") @db.VarChar(32)
  processingFingerprint  String              @db.Char(64)
  supersedesEvaluationId String?             @db.VarChar(36)
  indice                 Decimal             @db.Decimal(5, 2)
  nivel                  Nivel
  indicadores            Json
  scores                 Json
  contribuciones         Json
  ranking                Json
  excedidas              Json
  persistencia           Json
  snapshot               Json
  createdAt              DateTime            @default(now()) @db.DateTime(3)
  periodo                PeriodoEmpleado     @relation("EvaluacionesPeriodo", fields: [periodoId, employeeId], references: [periodoId, employeeId], onDelete: Restrict, onUpdate: Restrict)
  registroActual         RegistroLaboral     @relation("RegistroActualEvaluado", fields: [actualRecordId, periodoId], references: [recordId, periodoId], onDelete: Restrict, onUpdate: Restrict)
  registroAnterior       RegistroLaboral?    @relation("RegistroAnteriorEvaluado", fields: [anteriorRecordId, employeeId], references: [recordId, employeeId], onDelete: Restrict, onUpdate: Restrict)
  reglas                 ConfiguracionIndice @relation(fields: [rulesVersion], references: [version], onDelete: Restrict, onUpdate: Restrict)
  vigenteEn              PeriodoEmpleado[]   @relation("EvaluacionVigente")
  anteriorVersion        Evaluacion?         @relation("VersionesEvaluacion", fields: [supersedesEvaluationId, periodoId], references: [evaluationId, periodoId], onDelete: Restrict, onUpdate: Restrict)
  siguientesVersiones    Evaluacion[]        @relation("VersionesEvaluacion")
  alerta                 Alerta?

  @@unique([periodoId, processingFingerprint], map: "evaluacion_periodo_fingerprint_key")
  @@unique([evaluationId, periodoId])
  @@unique([evaluationId, employeeId])
  @@index([periodoId, employeeId])
  @@index([actualRecordId, periodoId])
  @@index([anteriorRecordId, employeeId])
  @@index([rulesVersion])
  @@index([supersedesEvaluationId, periodoId])
  @@index([nivel, createdAt])
}

model Alerta {
  alertId            String                @id @default(cuid()) @db.VarChar(36)
  evaluationId       String                @unique @db.VarChar(36)
  employeeId         String                @db.VarChar(64)
  destinatarioId     String?               @db.VarChar(64)
  motivoDestinatario MotivoDestinatario
  causas             Json
  sugerencias        Json
  vigencia           VigenciaAlerta        @default(ACTIVA)
  canal              CanalAlerta           @default(INTERNO)
  estadoEnvio        EstadoEnvio           @default(NO_APLICA)
  createdAt          DateTime              @default(now()) @db.DateTime(3)
  evaluacion         Evaluacion            @relation(fields: [evaluationId, employeeId], references: [evaluationId, employeeId], onDelete: Restrict, onUpdate: Restrict)
  empleado           Empleado              @relation("EmpleadoAlertado", fields: [employeeId], references: [employeeId], onDelete: Restrict, onUpdate: Restrict)
  destinatario       Empleado?             @relation("DestinatarioAlerta", fields: [destinatarioId], references: [employeeId], onDelete: Restrict, onUpdate: Restrict)
  intentos           IntentoNotificacion[]
  caso               CasoSeguimiento?

  @@unique([evaluationId, employeeId])
  @@index([employeeId, vigencia, createdAt])
  @@index([destinatarioId, vigencia])
  @@index([vigencia, createdAt, alertId])
}

enum EstadoIntentoNotificacion {
  PENDIENTE
  ENVIADO
  FALLIDO
  SIN_DESTINATARIO
}

enum ResultadoSimulado {
  EXITO
  FALLO
}

model IntentoNotificacion {
  intentoId      String                    @id @default(cuid()) @db.VarChar(36)
  alertId        String                    @db.VarChar(36)
  requestId      String                    @db.VarChar(36)
  numero         Int
  destinatarioId String?                   @db.VarChar(64)
  resultado      ResultadoSimulado
  canal          CanalAlerta               @default(SIMULADO)
  estado         EstadoIntentoNotificacion @default(PENDIENTE)
  detalle        String?                   @db.VarChar(255)
  createdAt      DateTime                  @default(now()) @db.DateTime(3)
  completedAt    DateTime?                 @db.DateTime(3)
  alerta         Alerta                    @relation(fields: [alertId], references: [alertId], onDelete: Restrict, onUpdate: Restrict)

  @@unique([alertId, requestId])
  @@unique([alertId, numero])
}

model ProcessingJob {
  jobId        String               @id @default(cuid()) @db.VarChar(36)
  origen       OrigenJob
  importId     String?              @unique @db.VarChar(36)
  rulesVersion String?              @db.VarChar(64)
  estado       EstadoJob            @default(PENDIENTE)
  createdBy    String               @db.VarChar(64)
  createdAt    DateTime             @default(now()) @db.DateTime(3)
  updatedAt    DateTime             @updatedAt @db.DateTime(3)
  startedAt    DateTime?            @db.DateTime(3)
  finishedAt   DateTime?            @db.DateTime(3)
  ownerToken   String?              @db.VarChar(64)
  leaseUntil   DateTime?            @db.DateTime(3)
  intentos     Int                  @default(0)
  importacion  Importacion?         @relation(fields: [importId], references: [importId], onDelete: Restrict, onUpdate: Restrict)
  reglas       ConfiguracionIndice? @relation(fields: [rulesVersion], references: [version], onDelete: Restrict, onUpdate: Restrict)
  pares        ProcessingJobPar[]

  @@index([estado, leaseUntil])
  @@index([rulesVersion])
}

// La lista no desaparece al fallar/reiniciar. El contador del DTO se deriva de pares.
model ProcessingJobPar {
  jobId        String          @db.VarChar(36)
  periodoId    String          @db.VarChar(36)
  orden        Int
  estado       EstadoJob       @default(PENDIENTE)
  errorCodigo  String?         @db.VarChar(64)
  errorDetalle String?         @db.Text
  updatedAt    DateTime        @updatedAt @db.DateTime(3)
  completedAt  DateTime?       @db.DateTime(3)
  job          ProcessingJob   @relation(fields: [jobId], references: [jobId], onDelete: Restrict, onUpdate: Restrict)
  periodo      PeriodoEmpleado @relation(fields: [periodoId], references: [periodoId], onDelete: Restrict, onUpdate: Restrict)

  @@id([jobId, periodoId])
  @@unique([jobId, orden])
  @@index([periodoId, estado])
}

enum EstadoSeguimiento {
  NUEVO
  EN_CURSO
  EN_ESPERA
  CERRADO
}

enum MotivoCierre {
  MEDIDAS_IMPLEMENTADAS
  SIN_ACCION_NECESARIA
  SUPERADA_POR_RECALCULO
  BAJA_PERSONA
}

// Follow-up of a person's alerts. One open case per person, enforced in the service under a
// row lock (MySQL has no partial unique index). Alerts of a case are queried by person and dates.
model CasoSeguimiento {
  casoId         String              @id @default(cuid()) @db.VarChar(36)
  employeeId     String              @db.VarChar(64)
  alertaOrigenId String              @unique @db.VarChar(36)
  estado         EstadoSeguimiento   @default(NUEVO)
  /// demo userId of the owner.
  asignadoA      String              @db.VarChar(64)
  vence          DateTime?           @db.Date
  motivoCierre   MotivoCierre?
  abiertoPor     String              @db.VarChar(64)
  cerradoPor     String?             @db.VarChar(64)
  createdAt      DateTime            @default(now()) @db.DateTime(3)
  updatedAt      DateTime            @default(now()) @updatedAt @db.DateTime(3)
  cerradoAt      DateTime?           @db.DateTime(3)
  empleado       Empleado            @relation(fields: [employeeId], references: [employeeId], onDelete: Restrict, onUpdate: Restrict)
  alertaOrigen   Alerta              @relation(fields: [alertaOrigenId], references: [alertId], onDelete: Restrict, onUpdate: Restrict)
  notas          NotaSeguimiento[]
  medidas        MedidaSeguimiento[]

  @@index([employeeId, estado])
  @@index([asignadoA, estado, vence])
}

// Append-only: no update or delete in service or API.
model NotaSeguimiento {
  notaId    String          @id @default(cuid()) @db.VarChar(36)
  casoId    String          @db.VarChar(36)
  autorId   String          @db.VarChar(64)
  texto     String          @db.VarChar(1000)
  createdAt DateTime        @default(now()) @db.DateTime(3)
  caso      CasoSeguimiento @relation(fields: [casoId], references: [casoId], onDelete: Restrict, onUpdate: Restrict)

  @@index([casoId, createdAt])
}

model MedidaSeguimiento {
  medidaId    String          @id @default(cuid()) @db.VarChar(36)
  casoId      String          @db.VarChar(36)
  /// Catalog key, e.g. REDISTRIBUIR_TAREAS.
  tipo        String          @db.VarChar(40)
  factor      String?         @db.VarChar(2)
  responsable String          @db.VarChar(64)
  vence       DateTime?       @db.Date
  hecha       Boolean         @default(false)
  createdAt   DateTime        @default(now()) @db.DateTime(3)
  updatedAt   DateTime        @default(now()) @updatedAt @db.DateTime(3)
  caso        CasoSeguimiento @relation(fields: [casoId], references: [casoId], onDelete: Restrict, onUpdate: Restrict)

  @@index([casoId])
}
