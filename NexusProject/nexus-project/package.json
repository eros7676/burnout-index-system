{
  "name": "nexus-project",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "typecheck": "next typegen && tsc --noEmit",
    "test": "tsc -p tsconfig.test.json && node scripts/test.mjs",
    "test:ui": "playwright test",
    "test:acceptance": "playwright test --config playwright.acceptance.config.ts",
    "verify:p0": "node scripts/verify-p0.mjs",
    "db:validate": "prisma validate",
    "db:compile-seed": "node scripts/seed.mjs --compile-only",
    "db:generate": "prisma generate",
    "db:migrate": "prisma migrate dev",
    "db:deploy": "prisma migrate deploy",
    "db:seed": "prisma db seed",
    "db:test": "tsc -p tsconfig.test.json && node scripts/test.mjs --mysql",
    "db:test:http": "tsc -p tsconfig.test.json && node .test-build/tests/importaciones.next.mysql.js",
    "rules:publish": "node scripts/rules-publish.mjs",
    "demo:tareas": "node scripts/demo-tareas-csv.mjs",
    "demo:jornadas": "node scripts/demo-jornadas-csv.mjs"
  },
  "dependencies": {
    "@gsap/react": "^2.1.2",
    "@prisma/client": "^6.19.3",
    "gsap": "^3.15.0",
    "lenis": "^1.3.27",
    "next": "16.4.2",
    "nodemailer": "10.1.7",
    "react": "19.3.0",
    "react-dom": "19.3.0"
  },
  "devDependencies": {
    "@playwright/test": "^1.64.1",
    "@tailwindcss/turbopack": "^4",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "dotenv": "^16.6.1",
    "eslint": "^9",
    "eslint-config-next": "16.4.2",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-prettier": "^5.5.7",
    "prettier": "^3.9.10",
    "prisma": "^6.19.3",
    "tailwindcss": "^4",
    "typescript": "^5"
  },
  "overrides": {
    "deepmerge-ts": "^8.0.0"
  },
  "engines": {
    "node": ">=20.9.0"
  }
}
