# Prisma: ejecutar sus comandos desde esta carpeta.
# Mantener las credenciales alineadas con el .env de la raíz (Docker).
DATABASE_URL="mysql://nexus_user:nexus_password@localhost:3306/nexus_workload"
# Optional: the other demo companies, each one its own database with the same migrations
# (Docs/empresas-demo.md). A company whose variable is unset is not offered.
# DATABASE_URL_TRANSPORTE="mysql://nexus_user:nexus_password@localhost:3306/nexus_rutas"
# DATABASE_URL_SALUD="mysql://nexus_user:nexus_password@localhost:3306/nexus_salud"

# Opcional: clave aleatoria privada compartida entre procesos para sesiones demo.
# Sin esta variable las sesiones expiran al reiniciar el servidor.
# DEMO_SESSION_SECRET="generar-una-clave-aleatoria-larga-y-no-subirla"

# Optional: send alert notices by real mail (SMTP). Without every MAIL_*/SMTP_* value below the
# delivery stays simulated. Every notice goes to MAIL_DESTINO_DEMO: the people in the demo data are
# fictitious, so nothing is sent to their addresses. Put the real password only in .env, never here.
# SMTP_HOST=mail.example.com
# SMTP_PORT=465
# SMTP_USER=nexo@example.com
# SMTP_PASSWORD=
# MAIL_FROM="Nexo Laboral <nexo@example.com>"
# MAIL_DESTINO_DEMO=demo-inbox@example.com
# Where the link in each notice points (defaults to http://127.0.0.1:3000).
# APP_URL=http://127.0.0.1:3000
